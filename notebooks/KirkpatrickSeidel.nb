Cell[BoxData[
 RowBox[{
  RowBox[{"QuickSelect", "[", 
   RowBox[{"ls_List", ",", "index_Integer", ",", 
    RowBox[{"lo_", ":", "1"}], ",", 
    RowBox[{"hi_", ":", "None"}], ",", 
    RowBox[{"depth_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pivot", ",", "cur", ",", 
      RowBox[{"newLs", "=", "ls"}], ",", 
      RowBox[{"hiVal", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"hi", "===", "None"}], ",", 
         RowBox[{"Length", "[", "ls", "]"}], ",", "hi"}], "]"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"lo", "==", "hiVal"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"newLs", "[", 
         RowBox[{"[", "lo", "]"}], "]"}], "]"}]}], "]"}], ";", 
     RowBox[{"pivot", "=", 
      RowBox[{"RandomInteger", "[", 
       RowBox[{"{", 
        RowBox[{"lo", ",", "hiVal"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newLs", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"newLs", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"lo", "->", 
           RowBox[{"newLs", "[", 
            RowBox[{"[", "pivot", "]"}], "]"}]}], ",", 
          RowBox[{"pivot", "->", 
           RowBox[{"newLs", "[", 
            RowBox[{"[", "lo", "]"}], "]"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cur", "=", "lo"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"newLs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "<", 
          RowBox[{"newLs", "[", 
           RowBox[{"[", "lo", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"cur", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"newLs", "=", 
           RowBox[{"ReplacePart", "[", 
            RowBox[{"newLs", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"cur", "->", 
                RowBox[{"newLs", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{"i", "->", 
                RowBox[{"newLs", "[", 
                 RowBox[{"[", "cur", "]"}], "]"}]}]}], "}"}]}], "]"}]}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"lo", "+", "1"}], ",", "hiVal"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newLs", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"newLs", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"cur", "->", 
           RowBox[{"newLs", "[", 
            RowBox[{"[", "lo", "]"}], "]"}]}], ",", 
          RowBox[{"lo", "->", 
           RowBox[{"newLs", "[", 
            RowBox[{"[", "cur", "]"}], "]"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"index", "<", "cur"}], ",", 
       RowBox[{"QuickSelect", "[", 
        RowBox[{"newLs", ",", "index", ",", "lo", ",", 
         RowBox[{"cur", "-", "1"}], ",", 
         RowBox[{"depth", "+", "1"}]}], "]"}], ",", 
       RowBox[{"index", ">", "cur"}], ",", 
       RowBox[{"QuickSelect", "[", 
        RowBox[{"newLs", ",", "index", ",", 
         RowBox[{"cur", "+", "1"}], ",", "hiVal", ",", 
         RowBox[{"depth", "+", "1"}]}], "]"}], ",", "True", ",", 
       RowBox[{"newLs", "[", 
        RowBox[{"[", "cur", "]"}], "]"}]}], "]"}]}]}], "]"}]}]], "Input",
