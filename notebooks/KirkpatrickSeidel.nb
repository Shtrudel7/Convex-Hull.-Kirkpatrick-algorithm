Cell[BoxData[
 RowBox[{
  RowBox[{"Bridge", "[", 
   RowBox[{"points_", ",", "verticalline_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "left", ",", "right", ",", "medianslope", ",", " ", "maxslope", ",", 
      "maxset", ",", "maxtableofb", ",", "pairs", ",", "large", ",", "equal", 
      ",", "small", ",", "candidates", ",", "xpair", ",", "slopes", ",", 
      "filteredPoints", ",", "medindex"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"candidates", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pairs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "points", "]"}], "==", "2"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"Sort", "[", "points", "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OddQ", "[", 
        RowBox[{"Length", "[", "points", "]"}], "]"}], ",", 
       RowBox[{"candidates", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{"{", 
           RowBox[{"points", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "}"}]}], "]"}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"pairs", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"SortBy", "[", 
          RowBox[{"#", ",", "First"}], "]"}], "&"}], ",", 
        RowBox[{"Partition", "[", 
         RowBox[{"points", ",", "2", ",", "2"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"filteredPoints", "=", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}], ">", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], ",", 
        RowBox[{"Cases", "[", 
         RowBox[{"pairs", ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x_", ",", "y_"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"u_", ",", "v_"}], "}"}]}], "}"}], "/;", 
           RowBox[{"x", "==", "u"}]}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"candidates", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"candidates", ",", "filteredPoints"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pairs", "=", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{"pairs", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x_", ",", "y_"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"u_", ",", "v_"}], "}"}]}], "}"}], "/;", 
         RowBox[{"x", "==", "u"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"slopes", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"pairs", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2", ",", "2"}], "]"}], "]"}], "-", 
           RowBox[{"pairs", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1", ",", "2"}], "]"}], "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"pairs", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2", ",", "1"}], "]"}], "]"}], "-", 
           RowBox[{"pairs", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1", ",", "1"}], "]"}], "]"}]}], ")"}]], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "pairs", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"EvenQ", "[", 
         RowBox[{"Length", "[", "slopes", "]"}], "]"}], "==", "True"}], ",", 
       RowBox[{"medindex", "=", 
        RowBox[{"Quotient", "[", 
         RowBox[{
          RowBox[{"Length", "[", "slopes", "]"}], ",", "2"}], "]"}]}], ",", 
       RowBox[{"medindex", "=", 
        RowBox[{
         RowBox[{"Quotient", "[", 
          RowBox[{
           RowBox[{"Length", "[", "slopes", "]"}], ",", "2"}], "]"}], "+", 
         "1"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"medianslope", "=", 
      RowBox[{"QuickSelect", "[", 
       RowBox[{"slopes", ",", "medindex"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"small", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"pairs", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a_", ",", "b_"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c_", ",", "d_"}], "}"}]}], "}"}], "/;", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"d", "-", "b"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"c", "-", "a"}], ")"}]}], ")"}], "<", 
          RowBox[{"medianslope", "-", 
           SuperscriptBox["10", 
            RowBox[{"-", "9"}]]}]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"equal", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"pairs", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a_", ",", "b_"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c_", ",", "d_"}], "}"}]}], "}"}], "/;", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"d", "-", "b"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"c", "-", "a"}], ")"}]}], ")"}], "-", "medianslope"}], 
           "]"}], "<", 
          SuperscriptBox["10", 
           RowBox[{"-", "9"}]]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"large", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"pairs", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a_", ",", "b_"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c_", ",", "d_"}], "}"}]}], "}"}], "/;", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"d", "-", "b"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"c", "-", "a"}], ")"}]}], ")"}], ">", 
          RowBox[{"medianslope", "+", 
           SuperscriptBox["10", 
            RowBox[{"-", "9"}]]}]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"maxtableofb", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"points", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
           RowBox[{"medianslope", "*", 
            RowBox[{"points", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}]}]}], ",", 
          RowBox[{"points", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "points", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"maxslope", "=", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"maxtableofb", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ">", 
           RowBox[{"#2", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], " ", "&"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"maxset", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"points", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"y", "-", 
             RowBox[{"medianslope", "*", "x"}], "-", "maxslope"}], "]"}], "<", 
           SuperscriptBox["10", 
            RowBox[{"-", "9"}]]}]}], ":>", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"left", "=", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"maxset", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
           RowBox[{"x", "==", 
            RowBox[{"Min", "[", 
             RowBox[{"maxset", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}]}], ":>", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}]}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"right", "=", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"maxset", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
           RowBox[{"x", "==", 
            RowBox[{"Max", "[", 
             RowBox[{"maxset", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}]}], ":>", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}]}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"left", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<=", "verticalline"}], "&&", 
        RowBox[{
         RowBox[{"right", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ">", "verticalline"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
