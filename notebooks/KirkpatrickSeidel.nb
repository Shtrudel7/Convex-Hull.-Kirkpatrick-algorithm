Cell[BoxData[
 RowBox[{
  RowBox[{"ConnectPoints", "[", 
   RowBox[{"lower_", ",", "upper_", ",", "points_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pointsleft", ",", "pointsright", ",", "left", ",", "right", ",", 
      "maxleft", ",", "minright"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"lower", "==", "upper"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "lower", "}"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"maxleft", " ", "=", " ", 
      RowBox[{"QuickSelect", "[", 
       RowBox[{"points", ",", 
        RowBox[{
         RowBox[{"Quotient", "[", 
          RowBox[{
           RowBox[{"Length", "[", "points", "]"}], ",", "2"}], "]"}], "+", 
         "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"minright", " ", "=", " ", 
      RowBox[{"QuickSelect", "[", 
       RowBox[{"points", ",", 
        RowBox[{"Quotient", "[", 
         RowBox[{
          RowBox[{"Length", "[", "points", "]"}], ",", "2"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"left", ",", "right"}], "}"}], " ", "=", " ", 
      RowBox[{"Bridge", "[", 
       RowBox[{"points", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"maxleft", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "+", 
           RowBox[{"minright", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "2"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"pointsleft", " ", "=", " ", 
      RowBox[{
       RowBox[{"{", "left", "}"}], "~", "Join", "~", 
       RowBox[{"Cases", "[", 
        RowBox[{"points", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a_", ",", "b_"}], "}"}], "/;", 
           RowBox[{"a", "<", 
            RowBox[{"left", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ":>", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pointsright", " ", "=", " ", 
      RowBox[{
       RowBox[{"{", "right", "}"}], "~", "Join", "~", 
       RowBox[{"Cases", "[", 
        RowBox[{"points", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a_", ",", "b_"}], "}"}], "/;", 
           RowBox[{"a", ">", 
            RowBox[{"right", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ":>", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"ConnectPoints", "[", 
         RowBox[{"lower", ",", "left", ",", "pointsleft"}], "]"}], ",", 
        RowBox[{"ConnectPoints", "[", 
         RowBox[{"right", ",", "upper", ",", "pointsright"}], "]"}]}], "]"}], 
      "]"}], ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "]"}]}]], "Input",
