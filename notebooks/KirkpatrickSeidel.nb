Cell[BoxData[
 RowBox[{
  RowBox[{"Convexhull", " ", "[", "points_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"upperhull", ",", "lowerhull"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"upperhull", " ", "=", " ", 
       RowBox[{"UpperHull", "[", "points", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"lowerhull", " ", "=", " ", 
       RowBox[{"LowerHull", "[", "points", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", "[", "upperhull", "]"}], "===", 
         RowBox[{"First", "[", "lowerhull", "]"}]}], ",", 
        RowBox[{"upperhull", "=", 
         RowBox[{"Most", "[", "upperhull", "]"}]}]}], "]"}], ";"}], "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "upperhull", "]"}], "===", 
          RowBox[{"Last", "[", "lowerhull", "]"}]}], ",", 
         RowBox[{"lowerhull", "=", 
          RowBox[{"Most", "[", "lowerhull", "]"}]}]}], "]"}], ";"}], "*)"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"Join", "[", 
       RowBox[{"upperhull", ",", "lowerhull"}], "]"}], "]"}], ";"}]}], 
