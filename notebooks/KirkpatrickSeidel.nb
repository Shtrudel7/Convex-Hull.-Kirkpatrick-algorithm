     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"right", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "<=", "verticalline"}], ",", 
       RowBox[{
        RowBox[{"candidates", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"candidates", ",", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"Union", "[", 
              RowBox[{"equal", ",", "large"}], "]"}], ",", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"a_", ",", "b_"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"c_", ",", "d_"}], "}"}]}], "}"}], ":>", 
              RowBox[{"{", 
               RowBox[{"c", ",", "d"}], "}"}]}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"candidates", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"candidates", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"small", ",", "1"}], "]"}]}], "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"left", "[", 
