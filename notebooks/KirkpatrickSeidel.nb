(* Content-type: application/vnd.wolfram.mathematica *)
Notebook[{
Cell["Kirkpatrick-Seidel Convex Hull", "Title"],
Cell["Wolfram Language | Educational implementation of the marriage-before-conquest approach", "Subtitle"],
Cell["Open this notebook in Wolfram Mathematica and use Evaluation > Evaluate Notebook. Input data is loaded from ../data/problem1.txt.", "Text"],
Cell["Configuration", "Section"],
Cell[BoxData["ClearAll[QuickSelect, Bridge, ConnectPoints, UpperHull, LowerHull, Convexhull, Main];\n$RecursionLimit = 3000;\n(* Resolve files relative to the notebook rather than a Windows desktop path. *)\nprojectDirectory = DirectoryName[NotebookDirectory[]];\ndataFile = FileNameJoin[{projectDirectory, \"data\", \"problem1.txt\"}];"], "Input"],
Cell["QuickSelect — order statistic", "Section"],
Cell[BoxData["QuickSelect[ls_List, index_Integer, lo_: 1, hi_: None, depth_: 0] :=\n Block[{pivot, cur, newLs = ls, hiVal = If[hi === None, Length[ls], hi]},\n  If[lo == hiVal, Return[newLs[[lo]]]];\n  pivot = RandomInteger[{lo, hiVal}];\n  newLs = ReplacePart[newLs, {lo -> newLs[[pivot]], pivot -> newLs[[lo]]}];\n  cur = lo;\n  Do[\n   If[newLs[[i]] < newLs[[lo]],\n    cur++;\n    newLs = ReplacePart[newLs, {cur -> newLs[[i]], i -> newLs[[cur]]}]\n   ],\n   {i, lo + 1, hiVal}\n  ];\n  newLs = ReplacePart[newLs, {cur -> newLs[[lo]], lo -> newLs[[cur]]}];\n  Which[\n   index < cur, QuickSelect[newLs, index, lo, cur - 1, depth + 1],\n   index > cur, QuickSelect[newLs, index, cur + 1, hiVal, depth + 1],\n   True, newLs[[cur]]\n  ]\n ]"], "Input"],
Cell["Bridge — upper supporting segment", "Section"],
Cell[BoxData["Bridge[points_, verticalline_] :=\n Block[{left, right, medianslope, maxslope, maxset, maxtableofb,\n   pairs, large, equal, small, candidates, slopes, filteredPoints, medindex},\n  candidates = {};\n  pairs = {};\n  If[Length[points] == 2, Return[Sort[points]]];\n  If[OddQ[Length[points]], candidates = Join[candidates, {points[[-1]]}]];\n  pairs = Map[SortBy[#, First] &, Partition[points, 2, 2]];\n  filteredPoints = Map[If[#[[1, 2]] > #[[2, 2]], #[[1]], #[[2]]] &,\n    Cases[pairs, {{x_, y_}, {u_, v_}} /; x == u]];\n  candidates = Join[candidates, filteredPoints];\n  pairs = DeleteCases[pairs, {{x_, y_}, {u_, v_}} /; x == u];\n  If[pairs === {},\n   Return[{First@SortBy[points, First], Last@SortBy[points, First]}]\n  ];\n  slopes = Table[\n    (pairs[[i, 2, 2]] - pairs[[i, 1, 2]])/\n      (pairs[[i, 2, 1]] - pairs[[i, 1, 1]]),\n    {i, 1, Length[pairs]}\n  ];\n  medindex = Ceiling[Length[slopes]/2];\n  medianslope = QuickSelect[slopes, medindex];\n  small = Cases[pairs, {{a_, b_}, {c_, d_}} /;\n     ((d - b)/(c - a)) < medianslope - 10^-9];\n  equal = Cases[pairs, {{a_, b_}, {c_, d_}} /;\n     Abs[((d - b)/(c - a)) - medianslope] < 10^-9];\n  large = Cases[pairs, {{a_, b_}, {c_, d_}} /;\n     ((d - b)/(c - a)) > medianslope + 10^-9];\n  maxtableofb = Table[\n    {points[[i, 2]] - medianslope*points[[i, 1]], points[[i]]},\n    {i, 1, Length[points]}\n  ];\n  maxslope = Max[maxtableofb[[All, 1]]];\n  maxset = Cases[points, {x_, y_} /;\n     Abs[y - medianslope*x - maxslope] < 10^-9 :> {x, y}];\n  left = First@SortBy[maxset, First];\n  right = Last@SortBy[maxset, First];\n  If[left[[1]] <= verticalline && right[[1]] >= verticalline,\n   Return[{left, right}]\n  ];\n  If[right[[1]] < verticalline,\n   candidates = Join[candidates,\n     Cases[Union[equal, large], {{a_, b_}, {c_, d_}} :> {c, d}]];\n   candidates = Join[candidates, Flatten[small, 1]]\n  ];\n  If[left[[1]] > verticalline,\n   candidates = Join[candidates,\n     Cases[Union[equal, small], {{a_, b_}, {c_, d_}} :> {a, b}]];\n   candidates = Join[candidates, Flatten[large, 1]]\n  ];\n  Bridge[DeleteDuplicates[candidates], verticalline]\n ]"], "Input"],
Cell["ConnectPoints — recursive upper chain", "Section"],
Cell[BoxData["ConnectPoints[lower_, upper_, points_] :=\n Block[{pointsleft, pointsright, left, right, maxleft, minright, sorted},\n  If[lower == upper, Return[{lower}]];\n  sorted = Sort[DeleteDuplicates[points]];\n  If[Length[sorted] == 2, Return[sorted]];\n  maxleft = QuickSelect[sorted, Quotient[Length[sorted], 2] + 1];\n  minright = QuickSelect[sorted, Quotient[Length[sorted], 2]];\n  {left, right} = Bridge[sorted, (maxleft[[1]] + minright[[1]])/2];\n  pointsleft = Join[{left}, Cases[sorted, {a_, b_} /; a < left[[1]] :> {a, b}]];\n  pointsright = Join[{right}, Cases[sorted, {a_, b_} /; a > right[[1]] :> {a, b}]];\n  Join[ConnectPoints[lower, left, pointsleft],\n       ConnectPoints[right, upper, pointsright]]\n ]"], "Input"],
Cell["UpperHull and LowerHull", "Section"],
Cell[BoxData["UpperHull[points_] :=\n Block[{lower, upper, candidates, xmin, xmax},\n  xmin = Min[points[[All, 1]]];\n  xmax = Max[points[[All, 1]]];\n  lower = First@MaximalBy[Select[points, First[#] == xmin &], Last];\n  upper = First@MaximalBy[Select[points, First[#] == xmax &], Last];\n  If[upper == lower, Return[{lower}]];\n  candidates = DeleteDuplicates@Join[{lower, upper},\n    Cases[points, {x_, y_} /; xmin < x < xmax :> {x, y}]];\n  ConnectPoints[lower, upper, candidates]\n ];\n\nLowerHull[points_] :=\n Block[{invertedPoints, invertedHull},\n  invertedPoints = points /. {x_, y_} :> {-x, -y};\n  invertedHull = UpperHull[invertedPoints];\n  invertedHull /. {x_, y_} :> {-x, -y}\n ]"], "Input"],
Cell["Convexhull — complete convex hull", "Section"],
Cell[BoxData["Convexhull[points_] :=\n Block[{upperhull, lowerhull},\n  upperhull = UpperHull[points];\n  lowerhull = LowerHull[points];\n  If[Last[upperhull] === First[lowerhull], upperhull = Most[upperhull]];\n  Join[upperhull, lowerhull]\n ]"], "Input"],
Cell["Main — load data, compute and visualize", "Section"],
Cell[BoxData["Main[] :=\n Module[{raw, mainpoints, ch, elapsed, plot},\n  raw = Import[dataFile, \"Table\"];\n  If[! ListQ[raw] || Length[raw] < 2,\n   Print[\"Invalid input file: \", dataFile]; Return[$Failed]\n  ];\n  (* First row specifies the number of points. *)\n  mainpoints = DeleteDuplicates[Rest[raw]];\n  {elapsed, ch} = AbsoluteTiming[Convexhull[mainpoints]];\n  Print[\"Hull vertices: \", Length[DeleteDuplicates[ch]]];\n  Print[\"Elapsed time (seconds): \", NumberForm[elapsed, {8, 5}]];\n  Print[\"Hull coordinates: \", ch];\n  plot = Show[\n    ListPlot[mainpoints, PlotStyle -> Directive[Blue, PointSize[0.016]]],\n    ListLinePlot[ch, PlotStyle -> Directive[Darker[Green], Thick]],\n    AspectRatio -> Automatic, PlotRange -> All,\n    Frame -> True, FrameLabel -> {\"x\", \"y\"},\n    PlotLabel -> \"Kirkpatrick-Seidel convex hull\", ImageSize -> Large\n  ];\n  plot\n ];\n\nMain[]"], "Input"]
}, WindowTitle -> "Kirkpatrick-Seidel Convex Hull", StyleDefinitions -> "Default.nb"]
